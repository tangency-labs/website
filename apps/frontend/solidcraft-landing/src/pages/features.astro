---
import Actions from "../components/Actions";
import ClosingCTA from "../components/ClosingCTA.astro";
import Icon from "../components/Icon.astro";
import { guide, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const formats = [
	[
		"SolidCraft / JSON",
		"Open",
		"Save / export",
		"Native design",
		"Editable features, parameters, and history. File-version compatibility applies.",
	],
	[
		"STEP",
		"Import",
		"Export",
		"B-rep geometry",
		"Imported geometry becomes a base feature; another CAD app’s original history is not restored.",
	],
	[
		"IGES",
		"Import",
		"Export",
		"B-rep / surfaces",
		"Supported solids or surfaces sewn into solids. Review import limitations.",
	],
	[
		"STL / OBJ / 3MF",
		"Mesh bodies",
		"Export",
		"Mesh geometry",
		"Imported meshes are not automatically editable solid features.",
	],
	[
		"DXF",
		"See guide",
		"Flat pattern",
		"Sheet-metal outlines",
		"Flat-pattern output does not imply a general-purpose drawing editor.",
	],
	[
		"URDF",
		"Not listed",
		"Export",
		"Assembly description",
		"Assemblies and joints for robot simulators; review the exporter’s scope.",
	],
];
---

<BaseLayout
	description="Explore SolidCraft’s constrained sketches, editable feature timeline, parameters, assemblies, sheet metal, and file exchange with clear limitations."
	title="Modeling features & file formats · SolidCraft"
>
	<section class="page-intro container">
		<p class="eyebrow">FEATURES</p>
		<h1>Parametric modeling tools.</h1>
		<p class="lead">
			Create constrained sketches, build solid features, and edit them in the
			timeline. Assemble components and import or export designs in the formats
			listed below.
		</p>
		<Actions />
	</section>
	<nav aria-label="Feature sections" class="subnav">
		<div class="container">
			<a href="#sketching">Sketching</a>
			<a href="#modeling">Modeling</a>
			<a href="#parameters">Parameters</a>
			<a href="#assemblies">Assemblies</a>
			<a href="#sheet-metal">Sheet metal</a>
			<a href="#file-exchange">File exchange</a>
		</div>
	</nav>
	<section class="feature-detail" id="sketching">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">01 / SKETCHING</p>
				<h2>Sketches, dimensions,<br>and constraints.</h2>
				<p class="lead">
					Draw a profile and add dimensions. Use constraints to keep lines
					parallel, connect endpoints, or control angles.
				</p>
				<ul>
					<li>Lines, arcs, circles, splines, and construction geometry.</li>
					<li>Dimensional and geometric constraints, with solver feedback.</li>
					<li>
						Sketches on origin planes, offset planes, or supported planar faces.
					</li>
				</ul>
				<a class="text-link" href={guide("sketching")}>
					Sketching & constraints guide<Icon name="external" size={18} />
				</a>
			</div>
			<figure class="image-frame">
				<img
					alt="SolidCraft’s sample plate shown with its sketch and feature timeline"
					height="1000"
					loading="lazy"
					src="/media/sample-plate.png"
					width="1600"
				>
				<figcaption>
					Upstream sample-plate capture · SolidCraft contributors · MIT OR
					Apache-2.0
				</figcaption>
			</figure>
		</div>
	</section>
	<section class="feature-detail section-alt" id="modeling">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">02 / SOLID MODELING</p>
				<h2>Edit features<br>in the timeline.</h2>
				<p class="lead">
					Extrude or revolve a sketch into a solid, then add features such as
					fillets and shells. Edit an earlier feature to rebuild the model.
				</p>
				<a class="text-link" href={guide("features")}>
					Solid features & limitations<Icon name="external" size={18} />
				</a>
			</div>
			<div class="prose">
				<h3>Supported operations.</h3>
				<p>
					The feature guide covers extrude, revolve, sweep, loft, fillet,
					chamfer, shell, patterns, and other supported operations. Features can
					be edited, suppressed, renamed, reordered, or deleted.
				</p>
				<p>
					Supported geometry varies by operation. See the feature guide and
					issue tracker for known limitations.
				</p>
				<a class="text-link" href="/showcase/pi-enclosure/">
					Watch the enclosure demo<Icon size={18} />
				</a>
			</div>
		</div>
	</section>
	<section class="feature-detail" id="parameters">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">03 / PARAMETERS</p>
				<h2>Named parameters<br>and configurations.</h2>
				<p class="lead">
					Give dimensions names, calculate values with expressions, and use
					configurations to store variations of a design.
				</p>
				<a class="text-link" href={guide("parameters")}>
					Parameters & expressions guide<Icon name="external" size={18} />
				</a>
			</div>
			<div>
				<figure class="image-frame">
					<img
						alt="The Parameters panel with board dimensions, wall thickness, and enclosure height"
						height="900"
						loading="lazy"
						src="/media/enclosure-parameter.jpg"
						width="1600"
					>
					<figcaption>
						Enclosure demonstration · named dimensions and expressions ·
						recorded with SolidCraft 0.22.1
					</figcaption>
				</figure>
			</div>
		</div>
	</section>
	<section class="feature-detail" id="assemblies">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">04 / ASSEMBLIES</p>
				<h2>Components and joints.</h2>
				<p class="lead">
					Organize components and occurrences, define joints, and inspect how
					parts fit into a larger design.
				</p>
				<a class="text-link" href={guide("assemblies")}>
					Components & joints guide<Icon name="external" size={18} />
				</a>
			</div>
			<figure class="image-frame">
				<img
					alt="SELENE’s wheels, chassis, solar panels, and instruments as a SolidCraft assembly"
					height="900"
					loading="lazy"
					src="/media/rover-poster.jpg"
					width="1600"
				>
				<figcaption>
					SELENE by 0xlillith · concept assembly · not a validated physical
					simulation
				</figcaption>
			</figure>
		</div>
	</section>
	<section class="feature-detail section-alt" id="sheet-metal">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">05 / SHEET METAL AND PLASTIC</p>
				<h2>Sheet metal<br>and plastic parts.</h2>
				<p class="lead">
					Work with rule-driven sheet-metal features and flat-pattern output, or
					use plastic-part tools for housing details.
				</p>
			</div>
			<div class="prose">
				<h3>Flat patterns and DXF export.</h3>
				<p>
					Sheet-metal workflows include flanges, hems, fold and unfold
					operations, flat patterns, and bend information. The v0.12.0 release
					adds improvements to flat-pattern DXF and conversion.
				</p>
				<p>
					A flat pattern is a modeling result. Check material behavior,
					dimensions, tooling, and tolerances before fabrication.
				</p>
				<div class="actions">
					<a class="text-link" href={guide("sheet-metal")}>
						Sheet metal guide<Icon name="external" size={18} />
					</a>
					<a class="text-link" href={guide("plastic")}>
						Plastic parts guide<Icon name="external" size={18} />
					</a>
				</div>
			</div>
		</div>
	</section>
	<section class="section" id="file-exchange">
		<div class="container">
			<p class="eyebrow">06 / IMPORT AND EXPORT</p>
			<h2>Supported file formats.</h2>
			<p class="lead" style="margin-top:24px">
				Native files keep editable features and history. STEP and IGES carry
				geometry; mesh formats carry polygon meshes. Import and export support
				are listed separately below.
			</p>
			<div
				aria-label="File format support and limitations"
				class="format-table-wrapper"
				role="region"
				tabindex="0"
			>
				<table>
					<caption class="sr-only">
						Source-reviewed format inventory; not independent testing of each
						release artifact
					</caption>
					<thead>
						<tr>
							<th scope="col">Format</th>
							<th scope="col">Import</th>
							<th scope="col">Export</th>
							<th scope="col">Representation</th>
							<th scope="col">Scope & limitations</th>
						</tr>
					</thead>
					<tbody>
						{formats.map((row) => (
							<tr>
								{row.map((cell, i) =>
									i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
								)}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="small muted" style="margin-top:20px">
				Based on documentation at revision 843c548 (October 15, 2026). Package
				compatibility has not been independently tested.
			</p>
			<div class="actions" style="margin-top:24px">
				<a class="text-link" href={guide("files")}>
					Import & export guide<Icon name="external" size={18} />
				</a>
				<a class="text-link" href={`${site.repo}/issues`}>
					Current issues<Icon name="external" size={18} />
				</a>
			</div>
		</div>
	</section>
	<ClosingCTA />
</BaseLayout>
