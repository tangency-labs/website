---
interface Props {
	model: "enclosure" | "rover";
	variant?: "workflow" | "parameter-change";
}
const { model, variant = "workflow" } = Astro.props;
const enclosure = model === "enclosure";
const parameterChange = enclosure && variant === "parameter-change";
const captionId = `${parameterChange ? "parameter-change" : model}-caption`;
const source = `/media/${parameterChange ? "enclosure-parameter" : model}.mp4`;
---

<figure class="product-media">
	<video
		aria-describedby={captionId}
		aria-label={parameterChange
			? "Watch the enclosure height change from 24 to 32 mm"
			: enclosure
				? "Watch the enclosure modeling workflow"
				: "Watch the SELENE rover timeline replay"}
		autoplay
		height={parameterChange ? 900 : 1080}
		loop
		muted
		playsinline
		poster={parameterChange
			? "/media/enclosure-parameter.jpg"
			: `/media/${model}-poster.jpg`}
		preload="metadata"
		width={parameterChange ? 1600 : 1920}
	>
		<source src={source} type="video/mp4">
		<a href={source}>Download the demonstration video</a>
	</video>
	<figcaption id={captionId}>
		<a href={enclosure ? "/showcase/pi-enclosure/" : "/showcase/selene/"}>
			How it was built<span aria-hidden="true"> →</span>
		</a>
	</figcaption>
</figure>
